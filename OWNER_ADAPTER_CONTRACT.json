{
  "schema_version": "3.7",
  "continuity_contract": "3.7",
  "required_metadata": ["task_id","task_class","domain","title","status","resume_eligible","resume_visibility","recovery_owner","updated_at","current_stage","next_action","checkpoint_ref","contract_version"],
  "recommended_protocol_metadata": ["continuity_protocol_version","domain_contract_version","last_protocol_reconciled_at","protocol_migration"],
  "user_task_metadata": {"display_name_zh":"required after first naming handshake","missing_behavior":"PROMPT_ONCE_THEN_PERSIST_AND_CONTINUE","identity_rule":"changing display_name_zh never changes task_id"},
  "required_capabilities": ["list_resumable_tasks_metadata_only","get_task_checkpoint_by_id","compatibility_check","resume_or_migrate_or_block","provide_short_handoff_or_equivalent_checkpoint","provide_stable_artifact_refs_for_next_action","provide_pre_takeover_progress_state","persist_material_progress_with_owner_version_guard","reread_authoritative_state_after_write","reconcile_supported_older_continuity_protocol_without_user_migration"],
  "artifact_context_governance": {
    "policy": "ARTIFACT_CONTEXT_GOVERNANCE_POLICY.json",
    "owner_must_expose": ["durable_task_state_location","authoritative_business_evidence_classes","canonical_artifact_or_file_stores","cache_or_reference_only_stores","stable_identity_strategy","read_freshness_requirements","mutation_conflict_strategy","post_write_verification_method","upstream_to_downstream_invalidation_rule","delete_and_retention_rules","superseded_artifact_cleanup_rule","external_artifact_vault_if_any"],
    "cache_may_be_checkpoint_authority": false,
    "chat_memory_may_be_checkpoint_authority": false,
    "external_reference_is_authority_by_presence": false,
    "chat_only_material_change_requires_persistence_before_future_resume": true,
    "superseded_active_implementation_should_be_removed_or_demoted": true,
    "material_file_mutation_requires_postcondition_verification": true,
    "destructive_mutation_requires_stable_identity_and_dependency_check": true,
    "tool_success_alone_is_commit_proof": false,
    "domain_specific_retention_stays_owner_controlled": true
  },
  "operational_hygiene_and_learning": {
    "owner_must_expose": ["observability_or_incident_evidence_location","self_maintenance_trigger_path","learning_evidence_location","eval_or_regression_promotion_path","garbage_collection_owner_and_dependency_rule","reliability_or_change_freeze_guard","superseded_mechanism_cleanup_rule"],
    "repeated_material_failure_requires_durable_incident_or_failure_evidence": true,
    "repeated_user_restating_same_durable_requirement_is_reliability_signal": true,
    "chat_only_fix_counts_as_learning": false,
    "declared_learning_role_without_invocation_and_receipt_is_operational": false,
    "solution_proposal_from_user_assistant_or_other_agent_is_candidate_not_authority": true,
    "user_goal_and_constraint_must_be_separated_from_user_proposed_mechanism": true,
    "nontrivial_evolution_candidate_requires_alternative_comparison_and_failure_mode_search": true,
    "promotion_requires_eval_or_regression_evidence": true,
    "accepted_evolution_should_remove_or_demote_superseded_mechanism_when_safe": true,
    "domain_specific_evolution_may_specialize_method_but_must_preserve_cross_agent_evidence_reliability_and_authority_invariants": true,
    "owner_override_may_replace_method_but_not_bypass_required_evidence_or_owner_boundaries": true,
    "core_reliability_failure_should_freeze_unrelated_feature_expansion_within_affected_owner": true,
    "freeze_must_not_spread_to_unrelated_healthy_owners": true,
    "universal_may_validate_conformance_without_business_state_rewrite": true,
    "business_specific_incident_taxonomy_and_retention_stay_owner_controlled": true
  },
  "methodology_composition": {
    "profile_contract_version": "1.0",
    "owner_declaration_contract_version": "1.1",
    "operational_profile_run_contract_version": "1.3",
    "model": "SMALL_STABLE_KERNEL_PLUS_COMPOSABLE_PROFILES_PLUS_OWNER_LOCAL_BINDINGS",
    "principle": "Reuse cross-agent invariants and narrow hook contracts. Do not copy a giant parent-agent behavior bundle into each owner and do not let a domain override replace cross-agent authority, evidence, reliability, or destructive-mutation safety.",
    "kernel_invariants": ["authority_precedence","single_writer_lease","verified_commit_after_authoritative_reread","candidate_is_not_production_authority","promotion_requires_evidence","destructive_mutation_requires_stable_identity_and_dependency_check"],
    "hook_sets": {
      "artifact_io": ["durable_task_state_location","authoritative_business_evidence_classes","canonical_artifact_or_file_stores","cache_or_reference_only_stores","stable_identity_strategy","read_freshness_requirements","mutation_conflict_strategy","post_write_verification_method","upstream_to_downstream_invalidation_rule","delete_and_retention_rules","superseded_artifact_cleanup_rule","external_artifact_vault_if_any"],
      "operational_hygiene": ["observability_or_incident_evidence_location","self_maintenance_trigger_path","garbage_collection_owner_and_dependency_rule","reliability_or_change_freeze_guard"],
      "evolution": ["learning_evidence_location","eval_or_regression_promotion_path","superseded_mechanism_cleanup_rule"]
    },
    "profiles": {
      "artifact_io": {"version":"1.0","required_hooks_from":"methodology_composition.hook_sets.artifact_io","semantics_owner":"ARTIFACT_CONTEXT_GOVERNANCE_POLICY.json","activation":"persistent artifact/file read, write, move, delete, publish, cache/reference promotion, or external artifact-vault use"},
      "operational_hygiene": {"version":"1.0","required_hooks_from":"methodology_composition.hook_sets.operational_hygiene","semantics_owner":"SYSTEM_MAINTENANCE_POLICY.json","activation":"durable owner maintenance, repeated failure, drift, incident, cleanup, or reliability recovery"},
      "evolution": {"version":"1.0","required_hooks_from":"methodology_composition.hook_sets.evolution","semantics_owner":"CONTINUOUS_LEARNING_POLICY.md","activation":"owner claims durable learning, self-improvement, methodology evolution, or production-rule promotion"}
    },
    "owner_declaration_contract": {
      "required_shape": "methodology.profile_refs + methodology.profile_applicability + methodology.hook_bindings + methodology.overrides",
      "profile_refs_must_pin_exact_version": true,
      "floating_latest_for_methodology_profiles_allowed": false,
      "profile_applicability_required_for_every_contract_profile": true,
      "profile_applicability_allowed_status": ["APPLIES","NOT_APPLICABLE"],
      "profile_applicability_requires_reason_and_evidence_refs": true,
      "applies_requires_profile_ref": true,
      "not_applicable_forbids_profile_ref": true,
      "negative_space_rule": "An owner may not silently omit a methodology profile. Every profile defined by the current contract must be explicitly assessed for applicability with owner-local evidence; APPLIES requires exact-version binding, while NOT_APPLICABLE requires a reason and evidence refs that make the exclusion reviewable.",
      "copy_shared_profile_prose_into_owner_required": false,
      "load_only_profiles_required_by_current_action": true,
      "domain_owner_keeps_business_implementation_and_evidence": true
    },
    "operational_profile_run_contract": {
      "required_profile_fields": ["receipt_contract_version","profile_id","profile_version","activation_id","trigger","action_binding","evidence_refs"],
      "receipt_contract_version_required": "1.3",
      "action_binding_required": true,
      "action_binding_required_fields": ["task_id","stage","action_id","subject_bindings","input_bindings"],
      "action_expectation_is_external_control_input": true,
      "duplicate_profile_runs_fail_closed": true,
      "duplicate_activation_ids_fail_closed": true,
      "hook_assessment_mode": "ACTION_SCOPED_NEGATIVE_SPACE",
      "hook_assessments_required": true,
      "hook_assessment_status": ["INVOKED","NOT_APPLICABLE_FOR_ACTION"],
      "every_profile_hook_must_be_assessed": true,
      "not_applicable_requires_reason_and_verified_evidence": true,
      "invoked_requires_reason_and_verified_evidence": true,
      "at_least_one_hook_must_be_invoked": true,
      "invoked_hooks_must_match_invoked_assessments": true,
      "unknown_hook_assessments_fail_closed": true,
      "legacy_invoked_hooks_only_receipt": "NOT_ADMISSIBLE_FOR_OPERATIONAL_PASS_UNDER_1_3",
      "receipt_1_2_without_exact_action_binding": "NOT_ADMISSIBLE_FOR_OPERATIONAL_PASS_UNDER_1_3",
      "independent_evidence_ref_verification_required": true,
      "independent_hook_assessment_verification_required": true,
      "evidence_ref_existence_alone_is_sufficient_for_hook_claim": false,
      "assessment_verifier_input": ["profile_id","hook_id","status","reason","verified_evidence_refs"],
      "principle": "Every activated profile run must bind the exact current task/stage/action and non-empty owner-specific subject/input identities supplied independently as the action expectation. Duplicate runs or activation ids are ambiguous and fail closed. Evidence refs must first be independently verified, and a separate hook-assessment verifier must judge whether those refs and the reason support each INVOKED or NOT_APPLICABLE_FOR_ACTION claim."
    },
    "allowed_override_keys": ["implementation_binding","domain_taxonomy","thresholds","artifact_locations","evaluator_selection","domain_specific_retention_within_global_safety_boundary"],
    "forbidden_override_keys": ["authority_precedence","single_writer_lease","verified_commit_after_authoritative_reread","candidate_is_not_production_authority","promotion_requires_evidence","destructive_mutation_requires_stable_identity_and_dependency_check"],
    "extension_rule": "Owners may replace local implementation hooks or add domain-only methodology behind explicit owner extension points; they may not shadow another profile namespace or weaken a forbidden kernel invariant.",
    "versioning_rule": "A profile version changes only when its hook or invariant contract changes. Compatible implementation improvements stay in the semantics owner without forcing every owner to duplicate new prose. Owner declaration-shape or action-receipt hardening may advance its dedicated contract version without changing profile versions when profile hook/invariant contracts are unchanged.",
    "failure_containment": "A failing or outdated profile blocks only the affected owner capability/profile. It must not freeze unrelated healthy owners.",
    "legacy_owner_must_expose_lists": "COMPATIBILITY_MIRROR_DURING_PROFILE_MIGRATION; profile hook_sets are the composition source for new owner adapters. Remove the mirrors only after all durable owners have migrated and regression coverage proves no supported reader depends on them.",
    "executable_validator": "runtime/methodology_conformance.py"
  },
  "live_chat_reconciliation": {"policy":"LIVE_CHAT_RECONCILIATION_POLICY.json","user_migration_required":false,"same_chat_protocol_upgrade_preserves_resume_epoch":true,"same_chat_protocol_upgrade_preserves_active_lease":true,"new_chat_takeover_changes_lease":true,"maintenance_task_must_not_overwrite_another_active_task_writer_manifest":true,"supported_additive_edges":["3.3->3.7","3.5->3.7","3.6->3.7"]},
  "progress_observability": {"policy":"PROGRESS_OBSERVABILITY_POLICY.json","resume_progress_source":"authoritative task manifest plus short owner checkpoint","owner_should_expose":["status","current_stage","next_action","blockers_or_waiting_state","updated_at","checkpoint_ref","owner_version_or_manifest_version"],"commit_verification":"A material owner-state update is COMMITTED only after the owner authority is re-read and matches the intended durable state.","cache_write_is_not_commit_proof":true,"no_change_behavior":"NO_MATERIAL_CHANGE; do not force an owner heartbeat write"},
  "context_recovery": {"policy":"CONTEXT_RECOVERY_POLICY.json","owner_should_not_require_full_history_preload":true,"handoff_role":"current execution truth","artifact_reference_preferred_over_duplicate_content":true,"old_chat_history":"last resort only"},
  "bare_inherit_predicate": {"task_class":["USER"],"resume_eligible":true,"resume_visibility":["DEFAULT"],"status":["ACTIVE","WAITING","BLOCKED"]},
  "explicit_system_infra": {"bare_inherit_eligible":false,"explicit_resume_allowed_when":"task_class=SYSTEM_INFRA + resume_eligible=true + resume_visibility=EXPLICIT_ONLY + explicit user selection"},
  "lease_epoch": {"canonical":"top-level resume_epoch","nested_active_lease_resume_epoch_required":false,"rule":"When nested active_lease.resume_epoch is absent, use top-level resume_epoch. When both exist and conflict, fail closed."},
  "fail_closed": {"missing_task_class":"MIGRATION","missing_resume_eligible":false,"missing_resume_visibility":"EXPLICIT_ONLY","missing_contract_version":"legacy-unclassified","missing_display_name_zh":"ASK_USER_ONCE; do not invent a permanent user-facing name","missing_checkpoint_or_next_action":"UNKNOWN; do not reconstruct executable state from chat memory","material_write_not_verified":"COMMIT_FAILED; do not claim the next chat can recover the new state","unsupported_old_protocol":"UNKNOWN_OR_INCOMPATIBLE; do not ask the user to reconstruct migration state","unclassified_cache_or_external_reference_conflict":"FAIL_CLOSED_OR_RESOLVE_THROUGH_OWNER; do not silently promote lower-authority context","file_identity_or_dependency_unknown_for_destructive_mutation":"BLOCK_MUTATION_OR_DELETE","declared_learning_without_invocation_or_receipt":"DECLARED_ONLY_NOT_OPERATIONAL","repeated_material_failure_without_durable_evidence":"OWNER_RELIABILITY_UNKNOWN_OR_UNHEALTHY","nontrivial_evolution_candidate_without_independent_comparison_or_failure_mode_search":"EVOLUTION_CANDIDATE_NOT_ADMISSIBLE","methodology_profile_version_or_hook_mismatch":"OWNER_METHODOLOGY_CONFORMANCE_FAILED","methodology_profile_applicability_missing_or_inconsistent":"OWNER_METHODOLOGY_CONFORMANCE_FAILED","methodology_action_binding_missing_or_mismatched":"OWNER_OPERATIONAL_METHODOLOGY_CONFORMANCE_FAILED","methodology_action_hook_assessment_missing_or_inconsistent":"OWNER_OPERATIONAL_METHODOLOGY_CONFORMANCE_FAILED","methodology_hook_claim_not_independently_supported":"OWNER_OPERATIONAL_METHODOLOGY_CONFORMANCE_FAILED","forbidden_methodology_override":"OWNER_METHODOLOGY_CONFORMANCE_FAILED"},
  "terminal_visibility_rule": "COMPLETE/ARCHIVED/ABANDONED must not be DEFAULT",
  "generic_fallback_owner": "GENERIC_HANDOFF"
}
