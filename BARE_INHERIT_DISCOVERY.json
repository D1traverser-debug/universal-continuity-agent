{
  "schema_version": "1.1",
  "continuity_contract": "3.7",
  "continuity_protocol_version": "3.7",
  "purpose": "Deterministic bare-inherit discovery quorum without parallel owner-name lists",
  "participant_authority": {
    "source": "OWNER_REGISTRY.json",
    "selector": "owners[*].bare_inherit_participant == true",
    "owner_field": "name",
    "source_field": "bare_inherit_source",
    "runtime_derivation": "runtime/owner_topology.py:bare_inherit_sources",
    "hard_coded_owner_list_allowed": false,
    "rule": "At the start of each bare CONTINUE, derive the required source set from the current OWNER_REGISTRY. Never use a remembered or copied owner-name list."
  },
  "candidate_filter": "task_class=USER + resume_visibility=DEFAULT + resume_eligible=true + status in ACTIVE/WAITING/BLOCKED",
  "completion_rule": "ALL_DERIVED_REQUIRED_SOURCES_MUST_BE_QUERIED",
  "on_source_failure": "INCOMPLETE_DISCOVERY",
  "count_rule": "DO_NOT_REPORT_TOTAL_CANDIDATE_COUNT_UNLESS_DISCOVERY_COMPLETE",
  "partial_results_rule": "MAY_SHOW_PARTIAL_RESULTS_ONLY_IF_EXPLICITLY_LABELED_INCOMPLETE; NEVER_CALL_THEM_THE_FULL_LIST",
  "dedupe_key": "task_id",
  "candidate_label": "display_name_zh preferred; title fallback",
  "max_presented_candidates": 5,
  "non_default_exclusions": ["SYSTEM_INFRA", "TEST", "FIXTURE", "EVAL", "MIGRATION", "EXPLICIT_ONLY", "HIDDEN", "PAUSED", "COMPLETE", "ARCHIVED", "ABANDONED"]
}
