{
  "schema_version": "3.2",
  "required_metadata": [
    "task_id",
    "task_class",
    "domain",
    "title",
    "status",
    "resume_eligible",
    "resume_visibility",
    "recovery_owner",
    "updated_at",
    "current_stage",
    "next_action",
    "checkpoint_ref",
    "contract_version"
  ],
  "user_task_metadata": {
    "display_name_zh": "required after first naming handshake",
    "missing_behavior": "PROMPT_ONCE_THEN_PERSIST_AND_CONTINUE",
    "identity_rule": "changing display_name_zh never changes task_id"
  },
  "required_capabilities": [
    "list_resumable_tasks_metadata_only",
    "get_task_checkpoint_by_id",
    "compatibility_check",
    "resume_or_migrate_or_block",
    "provide_short_handoff_or_equivalent_checkpoint",
    "provide_stable_artifact_refs_for_next_action"
  ],
  "context_recovery": {
    "policy": "CONTEXT_RECOVERY_POLICY.json",
    "owner_should_not_require_full_history_preload": true,
    "handoff_role": "current execution truth",
    "artifact_reference_preferred_over_duplicate_content": true,
    "old_chat_history": "last resort only"
  },
  "bare_inherit_predicate": {
    "task_class": ["USER"],
    "resume_eligible": true,
    "resume_visibility": ["DEFAULT"],
    "status": ["ACTIVE", "WAITING", "BLOCKED"]
  },
  "fail_closed": {
    "missing_task_class": "MIGRATION",
    "missing_resume_eligible": false,
    "missing_resume_visibility": "EXPLICIT_ONLY",
    "missing_contract_version": "legacy-unclassified",
    "missing_display_name_zh": "ASK_USER_ONCE; do not invent a permanent user-facing name",
    "missing_checkpoint_or_next_action": "UNKNOWN; do not reconstruct executable state from chat memory"
  },
  "terminal_visibility_rule": "COMPLETE/ARCHIVED/ABANDONED must not be DEFAULT",
  "generic_fallback_owner": "GENERIC_HANDOFF"
}
